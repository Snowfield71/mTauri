{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mtauri",
  "version": "0.1.0",
  "identifier": "com.mtauri.app",
  "build": {
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "mtauri",
        "width": 320,
        "height": 415,
        "center": true,
        "useHttpsScheme": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src http://175.178.179.146:3000; img-src 'self' http://175.178.179.146:3000 blob: data: https:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
